integration/part4/receipts/** -text
integration/part4/receipts/**/*.ansi -diff
integration/part4/receipts/**/*.txt -diff
# All retained CAS transports and execution logs keep their original bytes.
examples/**/blobs/* -diff
examples/**/*.log -diff
examples/current-handoff/**/*.ansi -diff
examples/current-handoff/**/*.txt -diff
