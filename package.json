{
  "name": "heurisko",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "build": "pnpm --filter @heurisko/core... run build && node_modules/.bin/tsc -p integration/part4/tsconfig.json && pnpm --filter @heurisko/tui --filter @heurisko/cli --filter @heurisko/web run build",
    "typecheck": "pnpm run build && pnpm -r run typecheck",
    "test:foundation": "pnpm run build && node --test packages/core/tests/foundation.test.mjs",
    "test:contracts": "python3 packages/contracts/tests/validate_contracts.py && node packages/contracts/tests/smoke-handshake.mjs",
    "test:s2": "pnpm run build && node --test packages/core/tests/s2.test.mjs packages/core/tests/network.test.mjs",
    "test:s3": "pnpm run build && node --test packages/core/tests/s3.test.mjs",
    "test:audit": "pnpm run build && node --test packages/core/tests/audit-fixes.test.mjs packages/core/tests/parser-absence.test.mjs",
    "test:web": "pnpm run build && pnpm --filter @heurisko/web test",
    "web": "node apps/web/dist/main.js",
    "test:s4": "pnpm run build && node --test integration/part4/tests/readiness.test.mjs packages/tui/tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  }
}
