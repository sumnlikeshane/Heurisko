{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "baseUrl": "../..",
    "paths": {
      "@heurisko/contracts": ["packages/contracts/dist/index.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
